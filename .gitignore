# =============================================================================
# Runtime data — generated by Docker, never commit
# =============================================================================

# Pi-hole's persistent config and SQLite databases
etc-pihole/
etc-dnsmasq.d/

# Generated NRD blocklist and per-day cache files
feed/nrd.txt
feed/nrd.txt.tmp
feed/cache/

# Fetcher / gravity logs
*.log

# Raw gzipped downloads (if any leak outside /tmp)
*.gz

# =============================================================================
# Secrets — NEVER commit
# =============================================================================

# API key files (in case anyone drops one in the repo by mistake)
apikey
*.apikey
secrets/

# Environment files with real values
.env
.env.local
.env.*.local

# But DO commit example/template env files
!.env.example
!.env.template
!.env.sample

# =============================================================================
# Docker
# =============================================================================

# Personal compose overrides (per-user tweaks, not for the repo)
docker-compose.override.yml
docker-compose.override.yaml

# =============================================================================
# Editor / IDE
# =============================================================================

.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.project
.settings/
*.sublime-project
*.sublime-workspace
.vs/

# =============================================================================
# OS junk
# =============================================================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# =============================================================================
# Backup / temporary
# =============================================================================

*.bak
*.backup
*.orig
*.rej
*.tmp